{
  "name": "@getrheo/react",
  "version": "3.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "node ../../scripts/build-publishable-package.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@getrheo/attribution": "3.0.0",
    "@getrheo/contracts": "3.0.0",
    "@getrheo/flow-runtime": "3.0.0",
    "@getrheo/flow-ui-state": "3.0.0",
    "@getrheo/renderer-web": "3.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@rheo/config": "workspace:*",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/react-test-renderer": "^19",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-test-renderer": "19.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "license": "MIT",
  "private": false,
  "description": "Rheo React web SDK — embed flows in the browser with Stripe Payment Link checkout.",
  "homepage": "https://docs.getrheo.io/docs/developer-guide/sdk-web",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getrheo/rheo-js.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/getrheo/rheo-js/issues"
  }
}
