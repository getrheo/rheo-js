exports[`LayerRenderer > renders auth canvas entry screen (snapshot) 1`] = `"<div style="display:flex;flex-direction:column;height:100%;width:100%;background:#0a0a0a;color:#fafafa;font-family:system-ui, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif"><div style="position:relative;display:flex;flex-direction:column;box-sizing:border-box;flex:1;min-height:0;min-width:0"><div style="display:flex;flex-direction:column;flex:1;min-height:0;overflow-y:auto"><div data-layer-id="lyr_ac_in_b" style="position:relative;display:flex;flex-direction:column;gap:12px;box-sizing:border-box;padding-top:16px;padding-right:16px;padding-bottom:16px;padding-left:16px;width:100%;flex:1;align-self:stretch;min-height:0;min-width:0"><div data-layer-id="lyr_ac_in_h" style="position:relative"><div style="font-size:22px;font-weight:700;color:#ffffff;white-space:pre-wrap">Auth layer harness</div></div><div data-layer-id="lyr_ac_in_p" style="position:relative"><div style="font-size:14px;color:#ffffff;white-space:pre-wrap">OAuth rails, sign-in, and sign-up stacks for canvas + SDK smoke tests.</div></div><div data-layer-id="lyr_ac_in_go" style="position:relative"><button type="button" disabled="" style="padding-top:10px;padding-right:14px;padding-bottom:10px;padding-left:14px;border-radius:10px;background:#fafafa;color:#0a0a0a;border-width:0;border-style:solid;border-color:transparent;cursor:pointer;display:flex;flex-direction:row;gap:8px;align-items:center;justify-content:center;width:100%;box-sizing:border-box"><div data-layer-id="lyr_ac_in_go_t" style="position:relative"><div style="color:#000000;white-space:pre-wrap">Continue</div></div></button></div></div></div></div></div>"`;

exports[`LayerRenderer > renders the entry screen of the valid fixture (snapshot) 1`] = `"<div style="display:flex;flex-direction:column;height:100%;width:100%;background:#0a0a0a;color:#fafafa;font-family:-apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif"><div style="position:relative;display:flex;flex-direction:column;box-sizing:border-box;flex:1;min-height:0;min-width:0"><div style="display:flex;flex-direction:column;flex:1;min-height:0;overflow-y:auto"><div data-layer-id="lyr_welcome_body" style="position:relative;display:flex;flex-direction:column;gap:12px;box-sizing:border-box;padding-top:16px;padding-right:16px;padding-bottom:16px;padding-left:16px;width:100%;flex:1;align-self:stretch;min-height:0;min-width:0"><div data-layer-id="lyr_welcome_title" style="position:relative"><div style="font-size:24px;font-weight:700;color:#ffffff;white-space:pre-wrap">Welcome</div></div><div data-layer-id="lyr_welcome_cta" style="position:relative"><button type="button" disabled="" style="padding-top:10px;padding-right:14px;padding-bottom:10px;padding-left:14px;border-radius:10px;background:#fafafa;color:#0a0a0a;border-width:0;border-style:solid;border-color:transparent;cursor:pointer;display:flex;flex-direction:row;gap:8px;align-items:center;justify-content:center;width:100%;box-sizing:border-box"><div data-layer-id="lyr_welcome_cta_text" style="position:relative"><div style="color:#000000;white-space:pre-wrap">Let&#x27;s go</div></div></button></div></div></div></div></div>"`;
