{
  "name": "@getrheo/renderer-web",
  "version": "3.0.0",
  "private": false,
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node ../../scripts/build-publishable-package.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@getrheo/contracts": "3.0.0",
    "@getrheo/flow-runtime": "3.0.0",
    "@getrheo/flow-ui-state": "3.0.0",
    "@getrheo/renderer-core": "3.0.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.468.0",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@rheo/config": "workspace:*",
    "@rheo/seeds": "workspace:*",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/react-test-renderer": "^19.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6",
    "@rheo/contracts-fixtures": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "homepage": "https://docs.getrheo.io/docs/developer-guide/sdk",
  "description": "DOM layer renderer for Rheo flows (web SDK and dashboard preview).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getrheo/rheo-js.git",
    "directory": "packages/renderer-web"
  },
  "bugs": {
    "url": "https://github.com/getrheo/rheo-js/issues"
  }
}
